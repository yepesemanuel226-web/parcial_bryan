# ─────────────────────────────────────────────────────────────────
#  Copia este archivo como ".env" dentro de fastapi_iot_api/
#  y completa los valores reales.
#
#  La connection string la encuentras en Neon:
#  Tu proyecto → Connect → Connection string → Show password
# ─────────────────────────────────────────────────────────────────

# Conexión a Neon (PostgreSQL)
# Pega aquí la connection string completa con la contraseña visible
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-misty-snow-b76w9eax-pooler.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clave que debe mandar el ESP32 en el header X-API-Key
# Cámbiala por una cadena larga y aleatoria
API_KEY_ESP32=cambia-esta-clave-por-una-segura
