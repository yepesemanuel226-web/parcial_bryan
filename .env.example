# ──────────────────────────────────────────────────────────────────
#  Variables de entorno del proyecto IoT
#  Copia este archivo como ".env" dentro de fastapi_iot_api/ y
#  completa los valores reales.
# ──────────────────────────────────────────────────────────────────

# Conexión a TigerData (TimescaleDB Cloud)
# Formato: postgresql+psycopg2://usuario:password@host:puerto/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://tsdbadmin:TU_PASSWORD@sldqseeb8t.fetdrrkqxx.tsdb.cloud.timescale.com:33257/tsdb?sslmode=require

# ID del grupo en la tabla grupos
GRUPO_ID=1

# Clave que debe mandar el ESP32 en el header X-API-Key
API_KEY_ESP32=cambia-esta-clave-por-una-segura
